# Copy to .env and fill in. .env is git-ignored: never commit real tokens.
# Everything is optional: without Telegram the agent prints alerts, without Groq it uses the template.

# Telegram: create a bot with @BotFather, then get your chat id from
# https://api.telegram.org/bot<token>/getUpdates after messaging the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# IPs or ranges that must never be blocked, comma-separated, e.g. 10.0.0.1,192.168.1.0/24
ALLOWLIST=
